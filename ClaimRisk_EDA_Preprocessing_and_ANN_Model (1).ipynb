        "# Hyperparameter Tuning with Keras Tuner"
      ],
      "metadata": {
        "id": "XCqU_HOMMUuz"
      },
      "id": "XCqU_HOMMUuz"
    },
    {
      "cell_type": "code",
      "source": [
        "!pip install -q keras-tuner\n",
        "import keras_tuner as kt"
      ],
      "metadata": {
        "id": "IxUEQcUJMubu"
      },
      "id": "IxUEQcUJMubu",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def model_builder(hp):\n",
        "    hp_units1 = hp.Int(\"units1\", min_value=16, max_value=64, step=16)   # 16, 32, 48, 64\n",
        "    hp_units2 = hp.Int(\"units2\", min_value=8, max_value=32, step=8)     # 8, 16, 24, 32\n",
        "    hp_dropout = hp.Choice(\"dropout\", [0.2, 0.3, 0.5])\n",
        "    hp_lr = hp.Choice(\"learning_rate\", [0.01, 0.001, 0.0001])\n",
        "\n",
        "    model = keras.Sequential([\n",
        "        keras.layers.Input(shape=(n_features,)),\n",
        "        keras.layers.Dense(hp_units1, activation=\"relu\"),\n",
        "        keras.layers.Dropout(hp_dropout),\n",
        "        keras.layers.Dense(hp_units2, activation=\"relu\"),\n",
        "        keras.layers.Dropout(hp_dropout),\n",
        "        keras.layers.Dense(1, activation=\"sigmoid\")\n",
        "    ])\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=keras.optimizers.Adam(learning_rate=hp_lr),\n",
        "        loss=\"binary_crossentropy\",\n",
        "        metrics=[\"accuracy\", keras.metrics.AUC(name=\"auc\")]\n",
        "    )\n",
        "\n",
        "    return model\n",
        "\n",
        "tuner = kt.RandomSearch(\n",
        "    model_builder,\n",
        "    objective=kt.Objective(\"val_auc\", direction=\"max\"),\n",
        "    max_trials=10,\n",
        "    directory=\"my_tuning\",\n",
        "    project_name=\"claim_risk\"\n",
        ")\n",
        "\n",
        "# Callbacks stop early and reduce learning rate when val_loss stops improving\n",
        "early_stopping = EarlyStopping(monitor=\"val_loss\", patience=5, restore_best_weights=True)\n",
        "reduce_lr = ReduceLROnPlateau(monitor=\"val_loss\", factor=0.5, patience=3)\n",
        "\n",
        "tuner.search(\n",
        "    X_train, y_train,\n",
        "    epochs=50,\n",
        "    validation_data=(X_val, y_val),\n",
        "    callbacks=[early_stopping, reduce_lr]\n",
        ")\n",
        "\n",
        "best_model = tuner.get_best_models(1)[0]\n",
        "best_model.summary()\n",
        "\n",
        "# Print the best hyperparameters\n",
        "best_hp = tuner.get_best_hyperparameters(1)[0]\n",
        "print(best_hp.values)"
      ],
