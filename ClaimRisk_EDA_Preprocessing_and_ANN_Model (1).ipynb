      "cell_type": "markdown",
      "source": [
        "**Batch Normalization**"
      ],
      "metadata": {
        "id": "6_fbOLJaJmoN"
      },
      "id": "6_fbOLJaJmoN"
    },
    {
      "cell_type": "code",
      "source": [
        "from keras.layers import BatchNormalization\n",
        "\n",
        "# Build a model with Batch Normalization\n",
        "bn_model = keras.Sequential([\n",
        "    keras.layers.Input(shape=(n_features,)),\n",
        "    keras.layers.Dense(32, activation=\"relu\"),\n",
        "    BatchNormalization(),\n",
        "    keras.layers.Dense(16, activation=\"relu\"),\n",
        "    BatchNormalization(),\n",
        "    keras.layers.Dense(1, activation=\"sigmoid\")\n",
        "])\n",
        "\n",
        "# Compile\n",
        "bn_model.compile(\n",
        "    optimizer=\"adam\",\n",
        "    loss=\"binary_crossentropy\",\n",
        "    metrics=[\"accuracy\", keras.metrics.AUC(name=\"auc\")]\n",
        ")\n",
        "\n",
        "# Train\n",
        "bn_history = bn_model.fit(\n",
        "    X_train, y_train,\n",
        "    epochs=20,\n",
        "    batch_size=32,\n",
        "    validation_data=(X_val, y_val)\n",
        ")\n",
        "\n",
        "# Evaluate\n",
        "bn_loss, bn_acc, bn_auc = bn_model.evaluate(X_val, y_val, verbose=0)\n",
        "print(f\"BatchNorm: Val Loss = {bn_loss:.4f}, Val AUC = {bn_auc:.4f}\")"
      ],
