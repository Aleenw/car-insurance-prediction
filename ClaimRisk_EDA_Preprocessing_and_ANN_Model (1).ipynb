      "cell_type": "markdown",
      "source": [
        "# Regularization — Early Stopping, Dropout and L2"
      ],
      "metadata": {
        "id": "Hw9V4Juj-f8F"
      },
      "id": "Hw9V4Juj-f8F"
    },
    {
      "cell_type": "markdown",
      "source": [
        " **L2 Model**"
      ],
      "metadata": {
        "id": "7H4xdEcdCcVU"
      },
      "id": "7H4xdEcdCcVU"
    },
    {
      "cell_type": "code",
      "source": [
        "from keras.regularizers import l2\n",
        "\n",
        "# Build Model L2 Regularization\n",
        "L2_model = keras.Sequential([\n",
        "    keras.layers.Input(shape=(n_features,)),\n",
        "    keras.layers.Dense(32, activation=\"relu\", kernel_regularizer=l2(0.001)),\n",
        "    keras.layers.Dense(16, activation=\"relu\", kernel_regularizer=l2(0.001)),\n",
        "    keras.layers.Dense(1, activation=\"sigmoid\")\n",
        "])\n",
        "\n",
        "# Compile\n",
        "L2_model.compile(\n",
        "    optimizer=\"adam\",\n",
        "    loss=\"binary_crossentropy\",\n",
        "    metrics=[\"accuracy\", keras.metrics.AUC(name=\"auc\")]\n",
        ")\n",
        "\n",
        "# Train\n",
        "l2_history = L2_model.fit(\n",
        "    X_train, y_train,\n",
        "    epochs=20,\n",
        "    batch_size=32,\n",
        "    validation_data=(X_val, y_val)\n",
        ")"
      ],
