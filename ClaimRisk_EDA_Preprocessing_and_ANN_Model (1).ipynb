      "cell_type": "code",
      "source": [
        "# Experienced, safe driver\n",
        "customer_1 = {\n",
        "    \"AGE\": \"40-64\", \"GENDER\": \"female\", \"DRIVING_EXPERIENCE\": \"20-29y\",\n",
        "    \"EDUCATION\": \"university\", \"INCOME\": \"upper class\", \"CREDIT_SCORE\": 0.75,\n",
        "    \"VEHICLE_OWNERSHIP\": 1.0, \"VEHICLE_YEAR\": \"after 2015\", \"MARRIED\": 1.0,\n",
        "    \"CHILDREN\": 1.0, \"POSTAL_CODE\": 10238, \"ANNUAL_MILEAGE\": 10000.0,\n",
        "    \"VEHICLE_TYPE\": \"sedan\", \"SPEEDING_VIOLATIONS\": 0, \"DUIS\": 0, \"PAST_ACCIDENTS\": 0\n",
        "}\n",
        "\n",
        "# Young, new driver with violations\n",
        "customer_2 = {\n",
        "    \"AGE\": \"16-25\", \"GENDER\": \"male\", \"DRIVING_EXPERIENCE\": \"0-9y\",\n",
        "    \"EDUCATION\": \"high school\", \"INCOME\": \"poverty\", \"CREDIT_SCORE\": 0.35,\n",
        "    \"VEHICLE_OWNERSHIP\": 0.0, \"VEHICLE_YEAR\": \"before 2015\", \"MARRIED\": 0.0,\n",
