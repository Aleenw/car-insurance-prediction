        "    \"VEHICLE_TYPE\": \"sports car\", \"SPEEDING_VIOLATIONS\": 3, \"DUIS\": 1, \"PAST_ACCIDENTS\": 2\n",
        "}\n",
        "\n",
        "print(\"Customer 1:\", predict_claim(customer_1))\n",
        "print(\"Customer 2:\", predict_claim(customer_2))"
      ],
