      "source": [
        "**Early Stopping and Model Checkpointing**"
      ],
      "metadata": {
        "id": "ZRjip2NsGNzg"
      },
      "id": "ZRjip2NsGNzg"
    },
    {
      "cell_type": "code",
      "source": [
        "from keras.callbacks import EarlyStopping, ModelCheckpoint\n",
        "\n",
        "# Early Stopping: stop when val_loss doesn't improve for 5 epochs\n",
        "early_stopping = EarlyStopping(\n",
        "    monitor=\"val_loss\",\n",
        "    patience=5,\n",
        "    restore_best_weights=True\n",
        ")\n",
        "\n",
        "# Model Checkpoint: save the model only when val_loss improves\n",
