    {
      "cell_type": "markdown",
      "source": [
        "# Inference pipeline"
      ],
      "metadata": {
        "id": "k3N5IzflV8hz"
      },
      "id": "k3N5IzflV8hz"
    },
    {
      "cell_type": "code",
      "source": [
        "# Load the saved model and preprocessing files\n",
        "model = keras.models.load_model(\"claim_risk_model.keras\")\n",
        "preprocessor = joblib.load(\"claim_risk_preprocessor.joblib\")\n",
        "input_columns = joblib.load(\"claim_risk_input_columns.joblib\")"
      ],
      "metadata": {
        "id": "DFCEveriV5nf"
      },
      "id": "DFCEveriV5nf",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def predict_claim(customer):\n",
        "    # Convert the customer data to a DataFrame with the same columns as training\n",
        "    df = pd.DataFrame([customer])[input_columns]\n",
        "    df[\"POSTAL_CODE\"] = df[\"POSTAL_CODE\"].astype(str)\n",
        "\n",
        "    # Apply the same preprocessing, then predict\n",
        "    X = preprocessor.transform(df).astype(\"float32\")\n",
        "    prob = float(model.predict(X, verbose=0)[0][0])\n",
        "\n",
        "    # Convert probability to a risk level\n",
        "    if prob < 0.3:\n",
        "        risk = \"Low\"\n",
        "    elif prob < 0.6:\n",
        "        risk = \"Medium\"\n",
        "    else:\n",
        "        risk = \"High\"\n",
        "\n",
        "    return {\"claim_probability\": round(prob, 3), \"risk_level\": risk}"
      ],
      "metadata": {
        "id": "xJE5ymVuWjAY"
      },
      "id": "xJE5ymVuWjAY",
      "execution_count": null,
      "outputs": []
    },
