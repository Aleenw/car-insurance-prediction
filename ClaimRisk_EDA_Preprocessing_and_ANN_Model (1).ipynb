      "cell_type": "code",
      "source": [
        "# Evaluate all models on the validation set\n",
        "models = {\n",
        "    \"Baseline\": baseline_model,\n",
        "    \"L2\": L2_model,\n",
        "    \"Dropout\": dropout_model\n",
        "}\n",
        "\n",
        "for name, model in models.items():\n",
        "    results = model.evaluate(X_val, y_val, verbose=0, return_dict=True)\n",
        "    print(f\"{name}: Val Loss = {results['loss']:.4f}, Val AUC = {results['auc']:.4f}\")\n",
        "\n",
        "# Plot training vs validation loss for all three models\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
        "\n",
        "histories = [\n",
        "    (baseline_history, \"Baseline\"),\n",
        "    (l2_history, \"L2 Regularization\"),\n",
        "    (dropout_history, \"Dropout\")\n",
        "]\n",
        "\n",
        "for ax, (history, title) in zip(axes, histories):\n",
        "    ax.plot(history.history[\"loss\"], label=\"Training Loss\")\n",
        "    ax.plot(history.history[\"val_loss\"], label=\"Validation Loss\")\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(\"Epoch\")\n",
        "    ax.set_ylabel(\"Loss\")\n",
        "    ax.legend()\n",
